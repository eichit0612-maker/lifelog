# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite
# lifelog.db はコミットする（CI がビルド時にこれを読んで静的サイトを生成するため）。
# WAL のサイドカーだけ無視する。コミット前に `npm run db:checkpoint` を実行すること。
db/*.db-shm
db/*.db-wal

# 静的エクスポートの出力
/out
